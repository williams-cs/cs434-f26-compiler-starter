class Hanoi {
    int moves;

    void move(int n, int from, int to, int via) {
        if (n > 0) {
            move(n - 1, from, via, to);
            moves = moves + 1;
            move(n - 1, via, to, from);
        }
    }

    void main(string[] args) {
        move(10, 1, 3, 2);
        Library.printi(moves);
        Library.print("\n");
    }
}
