class Gcd {
    int gcd(int a, int b) {
        if (b == 0) {
            return a;
        }
        return gcd(b, a % b);
    }

    void main(string[] args) {
        Library.printi(gcd(252, 105));
        Library.print("\n");
        Library.printi(gcd(17, 5));
        Library.print("\n");
    }
}
