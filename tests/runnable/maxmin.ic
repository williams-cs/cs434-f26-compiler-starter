class MaxMin {
    void main(string[] args) {
        int[] a = new int[8];
        int i = 0;
        int max;
        int min;
        while (i < a.length) {
            a[i] = (i * 5) % 7;
            i = i + 1;
        }
        max = a[0];
        min = a[0];
        i = 1;
        while (i < a.length) {
            if (a[i] > max) {
                max = a[i];
            }
            if (a[i] < min) {
                min = a[i];
            }
            i = i + 1;
        }
        Library.print("max: ");
        Library.printi(max);
        Library.print("\n");
        Library.print("min: ");
        Library.printi(min);
        Library.print("\n");
    }
}
